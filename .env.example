# MongoDB
MONGODB_URI=mongodb://localhost:27017/shieldpay

# Shopify Partner App (from partners.shopify.com → Apps → your app)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Dev store domain for simulate-dispute endpoint
SHOPIFY_DEV_STORE=your-dev-store.myshopify.com

# App URL for OAuth redirects (optional — defaults to http://localhost:3000)
SHOPIFY_APP_URL=http://localhost:3000

# Set true to use mock Shopify data (tests / offline dev without API calls)
SHOPIFY_MOCK_MODE=false

# Ollama (P3 agent loop + P4 response generation)
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=qwen2.5:0.5b

# Optional: merchant ID for dashboard settings (defaults to SHOPIFY_DEV_STORE or demo-merchant)
# NEXT_PUBLIC_MERCHANT_ID=demo-merchant
