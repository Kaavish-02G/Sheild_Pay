# Required: PostgreSQL, schema applied by npx drizzle-kit push
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres

# Safe default: public, single-merchant demo. Never enter real customer/card data.
SHIELDPAY_DEMO_MODE=true
# Set a strong password to protect the merchant desk and core APIs with HTTP Basic.
# Username is admin. HTTPS is required outside localhost.
SHIELDPAY_ADMIN_PASSWORD=
# Optional separate token for authenticated module-to-module calls.
SHIELDPAY_INTERNAL_TOKEN=
# For an external deployment set these to the public HTTPS URL.
SHIELDPAY_APP_URL=http://localhost:3000
SHOPIFY_APP_URL=http://localhost:3000
NEXT_PUBLIC_MERCHANT_ID=demo-merchant
# Optional live Shopify adapter (no mock mode is needed for the built-in store)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_DEV_STORE=
# Route verified gateway webhooks to an already-connected merchant.
SHIELDPAY_WEBHOOK_MERCHANT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_GATEWAY_TYPE=stripe
# Leave unset/false for real gateway adapters. Local sim-* cases ALWAYS use mock.
PG_MOCK_MODE=false
# Optional original standalone mock-commerce server (see upstream/integrations)
MOCK_COMMERCE_URL=http://localhost:4010
MOCK_COMMERCE_API_KEY=
MOCK_COMMERCE_MODE=false
PLATFORM_MOCK_MODE=false
SHOPIFY_MOCK_MODE=false
# Evidence-only deterministic rebuttals work without Ollama.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
P3_REBUTTAL_FAST_MODE=true
P4_LIVE_FAST_MODE=true
P3_STEP_PAUSE_MS=100
# Protect scheduled deadline checks when using Vercel cron.
CRON_SECRET=
