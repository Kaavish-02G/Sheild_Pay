# MongoDB
MONGODB_URI=mongodb://localhost:27017/shieldpay

# Shopify Partner App (from partners.shopify.com → Apps → your app)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Dev store domain for simulate-dispute endpoint
SHOPIFY_DEV_STORE=your-dev-store.myshopify.com

# App URL for OAuth redirects (optional — defaults to http://localhost:3000)
SHOPIFY_APP_URL=http://localhost:3000

# Set true to use mock Shopify data (tests / offline dev without API calls)
SHOPIFY_MOCK_MODE=false

# Mock commerce backend (admin API — no storefront)
MOCK_COMMERCE_URL=http://localhost:4010
MOCK_COMMERCE_API_KEY=mock-commerce-key
MOCK_COMMERCE_PORT=4010
MOCK_COMMERCE_MODE=false
PLATFORM_MOCK_MODE=false

# Set true to route P2 evidence submission through the mock payment gateway (auto-enabled when SHOPIFY_MOCK_MODE=true)
PG_MOCK_MODE=false

# Ollama (P3 agent loop + P4 response generation)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
P3_INVESTIGATION_STEPS=3
P3_LIVE_FAST_MODE=true
P3_STEP_PAUSE_MS=700
P3_STEP_TIMEOUT_MS=30000
P3_REBUTTAL_MAX_ITERATIONS=3
P3_REBUTTAL_FAST_MODE=true

# Optional: merchant ID for dashboard settings (defaults to SHOPIFY_DEV_STORE or demo-merchant)
# NEXT_PUBLIC_MERCHANT_ID=demo-merchant

# P2 — Payment gateways (evidence submission)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
DEFAULT_GATEWAY_TYPE=stripe
SHIELDPAY_APP_URL=http://localhost:3000
